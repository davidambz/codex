{
  "name": "iaframe",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "ingest": "npm run ingest -w @iaframe/store --",
    "dev": "npm run dev -w @iaframe/desktop",
    "dev:web": "npm run dev -w @iaframe/ui"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^28.1.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "4.1.11"
  }
}
