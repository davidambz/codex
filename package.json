{
  "name": "iaframe",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.2",
    "vitest": "4.1.11"
  }
}
